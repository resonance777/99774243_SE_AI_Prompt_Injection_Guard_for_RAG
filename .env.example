# Copy this file to .env and fill in your own key.
# .env is git-ignored and must never be committed.
#
# Free key from https://console.groq.com  ->  API Keys
GROQ_API_KEY=gsk_...

# Optional: override the generation model if this one is retired.
# Current model list: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
